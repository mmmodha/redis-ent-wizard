# Local Compose — auth open for demos (default)
AUTH_DISABLED=true

# Okta OIDC (set AUTH_DISABLED=false)
# OKTA_ISSUER=https://your-org.okta.com/oauth2/default
# OKTA_CLIENT_ID=0oa...
# OKTA_AUDIENCE=0oa...   # usually same as client id for SPA access tokens
# OKTA_ADMIN_GROUPS=rew-admins,rew-ops

# Encrypt per-user uploaded SA JSON (required in shared deploys)
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional Postgres (also: docker compose --profile enterprise up)
# DATABASE_URL=postgres://rew:rew@db:5432/rew

# Concurrency / quotas
# JOB_GLOBAL_LIMIT=10
# JOB_PER_USER_LIMIT=2
# QUOTA_MAX_LIVE_CLUSTERS=5
# QUOTA_MAX_NODES=7
# QUOTA_MAX_NVME=8

# Optional host mounts
# GCP_CREDENTIALS_HOST_DIR=./data/credentials
# SSH_DIR=$HOME/.ssh
